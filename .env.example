# Porta do Servidor KVM (TCP)
KVM_PORT=5000

# Porta do Painel Web de Controle
UI_PORT=8080

# Porta para Descoberta Automática na Rede Local (UDP Broadcast)
KVM_DISCOVERY_PORT=5005

# Chave Secreta Compartilhada (Pre-Shared Key - PSK) para autenticação HMAC-SHA256
# Clientes devem ter a mesma chave para se conectarem ao servidor
KVM_SECRET_KEY=minha-chave-secreta-kvm-2026

# Ativar Sockets Criptografados com TLS (true / false)
KVM_USE_TLS=false

# Posição Padrão do Monitor do Cliente em relação ao Servidor (right, left, top, bottom)
CLIENT_EDGE=right

# Borda de retorno do cliente (calculada automaticamente como oposta, mas customizável)
RETURN_EDGE=left

# Ajustes de Sensibilidade do Mouse
MOUSE_SPEED=1.0
MOUSE_ACCEL=1.0

# Host do Servidor para o Cliente (opcional - a descoberta mDNS/UDP localiza automaticamente)
SERVER_HOST=servidor
